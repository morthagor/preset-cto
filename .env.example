# Variáveis de Ambiente - Preset CTO
# Copie este arquivo para `.env` e ajuste os valores para seu ambiente

# ===== DATABASE (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=presetcto_db
DB_USER=presetcto
DB_PASSWORD=presetcto_dev_password
DB_DRIVER=org.postgresql.Driver

# ===== SPRING BOOT =====
SPRING_PROFILE=dev
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api/v1

# ===== REDIS =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== RABBITMQ =====
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=presetcto
RABBITMQ_PASSWORD=presetcto_dev_password
RABBITMQ_VHOST=/

# ===== SECURITY & JWT =====
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION_MS=86400000

# ===== MOBILE API =====
MOBILE_APP_MIN_VERSION=0.1.0
MOBILE_API_BASE_URL=http://localhost:8080/api/v1

# ===== ENVIRONMENT =====
ENVIRONMENT=development
LOG_LEVEL=DEBUG
